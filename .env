# Copy this file to ".env" and fill it in.  (cp .env.example .env)

# ---- The wedding ----
WEDDING_NAME=Zebstel
COUPLE_NAMES=Zebulun & Ellie
# Optional: shows a countdown. Format YYYY-MM-DD
WEDDING_DATE=

# ---- Money ----
# Paystack supports NGN, GHS, ZAR, KES, USD
CURRENCY=NGN
GOAL_AMOUNT=1000000
MIN_AMOUNT=500
PRESET_AMOUNTS=5000,10000,20000,50000

# ---- Paystack (leave empty to run in TEST/DEMO mode with no real payments) ----
# Get it at dashboard.paystack.com > Settings > API Keys.
# Use sk_test_... while testing, sk_live_... when you are ready for real money.
PAYSTACK_SECRET_KEY=

# ---- Your website address (needed once it is online) ----
SITE_URL=

# ---- Admin page at /admin (username: anything, password: this) ----
# If empty, the admin page is switched off.
ADMIN_PASSWORD=

# ---- Optional: show bank-transfer details on the page ----
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Set to 1 only if your host puts a proxy in front of the app (Render, Railway, etc.)
TRUST_PROXY=0